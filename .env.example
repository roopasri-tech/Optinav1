# Copy to ".env" (same folder as docker-compose.yml) to change these. All are optional.

# Free key from https://openchargemap.org/site/develop/api - adds EV chargers from
# Open Charge Map on top of OpenStreetMap. Leave empty to use OpenStreetMap only.
OPENCHARGEMAP_API_KEY=

# Set to false to stop live OpenStreetMap lookups (only already-cached data is used).
USE_EXTERNAL_FACILITIES=true

# Default fuel prices in INR (approximate national averages; editable per trip in the API).
PETROL_PRICE=102
DIESEL_PRICE=90
CNG_PRICE=89
ELECTRICITY_PRICE=18
